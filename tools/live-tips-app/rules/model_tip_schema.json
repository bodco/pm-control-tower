{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "livetips/model_tip_schema.json",
  "title": "Output of the tip role",
  "description": "Either a tip (gist first) or an explicit skip ('facts or silence'). Structure is strict, lengths are generous: the diet length limits are measured and trimmed for display, not a reason to drop a tip.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "gist": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "level": {
          "enum": [
            "red",
            "orange",
            "info"
          ]
        },
        "phrase": {
          "type": "string",
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 5
        },
        "note": {
          "type": "string",
          "maxLength": 120
        },
        "topic": {
          "type": "string",
          "maxLength": 120
        },
        "trigger": {
          "type": "string"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new": {
          "type": "string",
          "maxLength": 160,
          "description": "What in this tip was not said aloud yet (2026-10-23)."
        }
      },
      "required": [
        "gist",
        "level",
        "topic"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "skip": {
          "const": true
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "skip"
      ],
      "additionalProperties": false
    }
  ]
}
