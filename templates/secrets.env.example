# ============================================================================
#  SECRETS FILE TEMPLATE
# ============================================================================
#
#  Where to put it (the only correct location, skills look exactly here):
#
#      ~/work/Secrets/secrets.env
#
#  How to create it:
#
#      mkdir -p ~/work/Secrets && chmod 700 ~/work/Secrets
#      cp templates/secrets.env.example ~/work/Secrets/secrets.env
#      chmod 600 ~/work/Secrets/secrets.env
#
#  RULES
#  1. One line = one variable. No quotes, no spaces around "=".
#  2. This file NEVER goes into git. .gitignore has "*.env" in it,
#     only this example with fake values is let through.
#  3. Values are never printed anywhere: not in a report, a ticket or a chat.
#     Skills read them like this:
#         grep '^JIRA_TOKEN=' ~/work/Secrets/secrets.env | cut -d= -f2-
#  4. Local MCP servers read this file ONCE at startup.
#     After any edit, RESTART Claude Desktop, otherwise the new
#     value is not picked up and the error looks like "invalid token".
#
# ============================================================================

# --- Task tracker (company Jira Server) -------------------------------------
JIRA_TOKEN=fake-jira-token-replace-me
JIRA_EMAIL=you@your-company.com

# --- Knowledge base (company Confluence) ------------------------------------
CONFLUENCE_TOKEN=fake-confluence-token-replace-me

# --- Notion (only if you run your own local MCP server) ---------------------
# The official Notion connector needs no token here.
NOTION_TOKEN=fake-notion-token-replace-me

# --- Slack (only if you run your own local MCP server) ----------------------
# The official Slack connector needs no token here.
SLACK_TOKEN=fake-slack-token-replace-me

# --- Project monitoring (optional, for stability-scan) ----------------------
PROJECT_SENTRY_TOKEN=fake-sentry-token-replace-me
