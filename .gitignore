# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets: nothing that looks like a credential, ever
*.env
secrets.*
*.pem
*.key
.git-credentials
# ...except the template with fake values
!templates/secrets.env.example
!plugin/templates/secrets.env.example

# Local editor / scratch
.idea/
.vscode/
*.swp
*.tmp

# Private working material, not for the public repo
speaker-notes/
speech/
private/
reviews/
prompts/
scripts/
# ...except the dashboard's own scripts (setup, doctor, build-single, make-icons)
!tools/dashboard/scripts/
Claude outputs/
Notion/
_to_delete/
*.zip


__pycache__/
*.pyc
.pytest_cache/

# quality gates (ub-mode: crapper, dryer, mutator)
.metrics/
target/
.coverage

# Pacenote search index (machine-local)
.livetips-index/
